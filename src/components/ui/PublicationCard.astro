---
import type { Publication } from '@/lib/types';
import { highlightSelf } from '@/lib/utils';

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
---

<a
  href={pub.url ?? undefined}
  target={pub.url ? '_blank' : undefined}
  rel={pub.url ? 'noopener noreferrer' : undefined}
  class:list={[
    'flex flex-row items-start gap-4 rounded-xl border border-border p-4 h-full transition-colors',
    pub.url && 'hover:border-accent',
  ]}
>
  {
    pub.image && (
      <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 overflow-hidden rounded-lg border border-border bg-white">
        <img
          src={pub.image}
          alt=""
          loading="lazy"
          class="h-full w-full object-contain p-1"
        />
      </div>
    )
  }
  <div class="flex flex-col gap-1.5 min-w-0">
    <span class="text-accent text-xs font-medium">{pub.venue} · {pub.year}</span>
    <span class="text-headings font-medium leading-snug">{pub.title}</span>
    <span
      class="text-muted-foreground text-xs leading-snug"
      set:html={highlightSelf(pub.authors)}
    />
  </div>
</a>
