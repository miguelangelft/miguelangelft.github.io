---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  logo: ImageMetadata;
  logoAlt: string;
  label: string;
  title: string;
  summary: string;
}

const { href, logo, logoAlt, label, title, summary } = Astro.props;
---

<a
  href={href}
  class="flex flex-col sm:flex-row items-start sm:items-center gap-5 rounded-xl border border-border p-4 h-full transition-colors hover:border-accent"
>
  <Image
    src={logo}
    alt={logoAlt}
    width={96}
    height={96}
    class="rounded-lg border border-border shrink-0 w-20 h-20 sm:w-24 sm:h-24"
  />
  <div class="flex flex-col gap-1.5">
    <span class="text-accent text-xs font-medium">{label}</span>
    <span class="text-headings font-medium leading-snug">{title}</span>
    <span class="text-muted-foreground text-sm leading-snug">{summary}</span>
    <span class="text-accent text-sm font-medium">Visit project page →</span>
  </div>
</a>
