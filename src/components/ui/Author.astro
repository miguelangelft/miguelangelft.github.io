---
import { Image } from 'astro:assets';
import { getImage } from 'astro:assets';
import type { AuthorInfo } from '@/lib/constants';

interface Props extends AuthorInfo {}
const { avatar, name, headline, location, pronouns, badges } = Astro.props;

const image = await getImage({ src: avatar, format: 'avif' });
---

<div class="flex items-center gap-5">
  <div class="relative rounded-full shrink-0 overflow-hidden ring-2 ring-accent-soft">
    <Image
      loading="eager"
      src={image.src}
      alt={name}
      width={108}
      height={108}
      class="rounded-full"
    />
  </div>
  <div class="flex flex-col gap-2">
    <div class="flex flex-col gap-0.5">
      <h1 class="text-2xl font-semibold text-headings leading-tight">{name}</h1>
      <p class="text-base text-foreground leading-tight">
        {headline} in {' '}
        <span>
          {location}
        </span>,
        {pronouns && (
          <span>
            {pronouns}
          </span>
        )}
      </p>
    </div>
    {badges && badges.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {badges.map((badge) => (
          <span class="text-accent text-xs font-medium bg-accent-soft px-2.5 py-1 rounded-full w-max leading-none">
            {badge}
          </span>
        ))}
      </div>
    )}
  </div>
</div>