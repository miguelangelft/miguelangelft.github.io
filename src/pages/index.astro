---
import { getEntry, getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Author from '@/components/ui/Author.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { DEFAULT_CONFIGURATION } from '@/lib/constants';
import WorkExperience from '@/components/ui/WorkExperience.astro';
import Talk from '@/components/ui/Talk.astro';
import Publication from '@/components/ui/Publication.astro';
import PublicationCard from '@/components/ui/PublicationCard.astro';
import Project from '@/components/ui/Project.astro';
import FeaturedProject from '@/components/ui/FeaturedProject.astro';
import seedLogo from '@/assets/images/seed-logo.png';
import closerLogo from '@/assets/images/closer-logo-square.png';
import ContactIcon from '@/components/ui/ContactIcon.astro';
import { sortByDateRange, sortByYear, groupByYear } from '@/lib/utils';
import { getSiteConfig } from '@/lib/config';
import publicationsData from '@/data/publications.json';
import projectsData from '@/data/projects.json';
import type { Publication as PublicationType } from '@/lib/types';

const entry = await getEntry('pages', 'homepage');

if (!entry) {
  throw new Error('Homepage entry not found');
}

const { Content } = await render(entry);

const CONTACT_ORDER = [
  'Email',
  'Google Scholar',
  'LinkedIn',
  'X',
  'Bluesky',
  'ORCID',
  'ResearchGate',
  'GitHub',
];
const links = (await getCollection('links'))
  .filter((link) => link.data.label !== 'Website')
  .sort(
    (a, b) =>
      CONTACT_ORDER.indexOf(a.data.label) -
      CONTACT_ORDER.indexOf(b.data.label),
  );

const jobs = await getCollection('jobs');
const sortedJobs = sortByDateRange(jobs);

const talks = await getCollection('talks');
const sortedTalks = sortByYear(talks);

const publications = publicationsData.publications as PublicationType[];
const highlightedPublications = publications
  .filter((pub) => pub.section === 'journal')
  .sort((a, b) => b.year - a.year)
  .slice(0, 6);
const publicationsByYear = groupByYear(publications);
const journalCount = publications.filter(
  (pub) => pub.section === 'journal',
).length;
const conferenceCount = publications.filter(
  (pub) => pub.section === 'conference',
).length;

const projects = projectsData.projects;

const config = getSiteConfig();

const cvUrl = '/cv/miguel-angel-fernandez-torres-cv.pdf';
---

<BaseLayout seo={entry.data.seo}>
  {config.elements.avatar && (
    <Container as="section" class="py-6">
      <Author {...DEFAULT_CONFIGURATION.author}>
          {config.sections.socialLinks && links.length > 0 && (
            <ul id="contact" class="flex flex-wrap items-center gap-1.5 pt-1 scroll-mt-24" aria-label="Contact and social profiles">
              {links.map((link) => (
                <li>
                  <a
                    href={link.data.url}
                    target={link.data.url.startsWith('mailto:') ? undefined : '_blank'}
                    rel="noopener noreferrer"
                    title={`${link.data.label}: ${link.data.name}`}
                    aria-label={link.data.label}
                    class="flex items-center justify-center w-9 h-9 rounded-full border border-border text-foreground transition-colors hover:border-accent hover:text-accent"
                  >
                    <ContactIcon label={link.data.label} size={18} />
                  </a>
                </li>
              ))}
            </ul>
          )}
      </Author>
    </Container>
  )}

  {config.sections.about && (
    <Container as="section" id="about" class="py-6 scroll-mt-24">
      <div class="flex flex-col gap-6">
        <SectionHeading title="About" />
        <div class="prose dark:prose-invert max-w-none">
          <Content />
        </div>
        <div class="flex flex-wrap items-center gap-4 text-sm">
          <span class="text-muted-foreground">
            {journalCount} journal papers (17 Q1) · {conferenceCount} conference papers · h-index 16 (Google Scholar)
          </span>
          <a
            href={cvUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent font-medium hover:underline shrink-0"
          >
            Download full CV (PDF) →
          </a>
        </div>
      </div>
    </Container>
  )}
  {
    config.sections.publications && publications.length > 0 && (
      <Container as="section" id="publications" class="py-6 scroll-mt-24">
        <div class="flex flex-col gap-5">
          <SectionHeading
            title="Publications"
            subtitle={`${publications.length} total`}
          />

          {highlightedPublications.length > 0 && (
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              {highlightedPublications.map((pub) => (
                <PublicationCard pub={pub} />
              ))}
            </div>
          )}

          <details class="group">
            <summary class="cursor-pointer list-none text-accent text-sm font-medium hover:underline w-max">
              <span class="group-open:hidden">Show all {publications.length} publications</span>
              <span class="hidden group-open:inline">Hide full publication list</span>
            </summary>
            <div class="flex flex-col gap-8 mt-6">
              {Array.from(publicationsByYear.entries()).map(([year, pubs]) => (
                <div class="flex flex-col gap-4">
                  <span class="text-muted-foreground text-sm font-medium">{year}</span>
                  <ul class="flex flex-col gap-6">
                    {pubs.map((pub) => (
                      <Publication pub={pub} />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </div>
      </Container>
    )
  }
  {
    config.sections.projects && projects.length > 0 && (
      <Container as="section" id="projects" class="py-6 scroll-mt-24">
        <div class="flex flex-col gap-5">
          <SectionHeading title="Research Projects" />
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <FeaturedProject
                href="/projects/closer"
                logo={closerLogo}
                logoAlt="CLOSER project logo"
                label="Featured project · Horizon Europe · PI at UC3M · 2026–2030"
                title="CLOSER: Closing the Loop — Attribution of Complex Climate Disasters to Climatic and to Policy Changes"
                summary="An integrated science of attribution, forecasting and impacts of climate-related disasters. UC3M contributes AI and remote sensing for a global database of hazards and impacts."
              />
              <FeaturedProject
                href="/projects/seed"
                logo={seedLogo}
                logoAlt="SEED project logo"
                label="Featured project · UC3M · PI · 2025–2026"
                title="SEED: Spatiotemporal Explainable Geospatial Artificial Intelligence for Extreme Events and Their Drivers"
                summary="Explainable AI to uncover the physical drivers of droughts and heatwaves learned by deep learning models. Funded by Universidad Carlos III de Madrid."
              />
            </div>
          <ul class="flex flex-col gap-8">
            {projects.map((project) => (
              <Project project={project} />
            ))}
          </ul>
        </div>
      </Container>
    )
  }
  {
    config.sections.workExperience && sortedJobs.length > 0 && (
      <Container as="section" id="experience" class="py-6 scroll-mt-24">
        <div class="flex flex-col gap-5">
          <SectionHeading title="Work Experience" />
          <ul class="flex flex-col gap-8">
            {sortedJobs.map((job) => (
              <WorkExperience entry={job} />
            ))}
          </ul>
        </div>
      </Container>
    )
  }
  {
    config.sections.talks && sortedTalks.length > 0 && (
      <Container as="section" id="speaking" class="py-6 scroll-mt-24">
        <div class="flex flex-col gap-5">
          <SectionHeading title="Speaking" />
          <ul class="flex flex-col gap-8">
            {sortedTalks.map((talk) => (
              <Talk entry={talk} />
            ))}
          </ul>
        </div>
      </Container>
    )
  }
</BaseLayout>
